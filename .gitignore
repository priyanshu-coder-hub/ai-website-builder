# ==========================================
# MERN Stack .gitignore
# ==========================================

# 1. Dependencies (Frontend & Backend)
node_modules/
.pnp
.pnp.js

# 2. Environment Variables
# SECURITY: Never commit your .env files! They contain your MongoDB URI and API keys.
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# 3. Build Outputs (React / Vite)
build/
dist/
out/

# 4. Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# 5. Testing & Coverage
coverage/
.nyc_output

# 6. IDEs and Editors
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# 7. OS Generated Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# 8. Misc & Caches
.eslintcache
npm-cache/
yarn-cache/